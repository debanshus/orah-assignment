{
  "name": "orah-api",
  "version": "1.0.0",
  "description": "Orah API",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsc --noEmit && npm run build && rm -rf dist && node --watch -r ts-node/register src/server.ts",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:sync": "npx typeorm-ts-node-commonjs schema:sync -d src/database/db.ts",
    "db:drop": "npx typeorm-ts-node-commonjs schema:drop -d src/database/db.ts",
    "db:seed": "node -r ts-node/register src/scripts/seed.ts",
    "cleanup": "npm run db:drop && npm run db:sync && npm run db:seed"
  },
  "dependencies": {
    "@orah/shared": "file:../shared",
    "bullmq": "^6.3.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "ioredis": "^5.11.1",
    "mysql2": "^3.10.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3"
  }
}
