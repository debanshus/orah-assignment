# ─── App ──────────────────────────────────────────────────────────
# Specifies the environment the application is running in (e.g., development, production)
NODE_ENV=development

# The port number on which the API server will listen for incoming requests
PORT=3000

# ─── Database (TypeORM / MySQL) ───────────────────────────────────
# The hostname or IP address of the MySQL database server
DB_HOST=127.0.0.1

# The port number the MySQL server is running on (default is 3306)
DB_PORT=3306

# The username used to authenticate with the MySQL database
DB_USER=root

# The password used to authenticate with the MySQL database
DB_PASSWORD=root

# The name of the MySQL database where application data is stored
DB_NAME=orah

# ─── Redis Configuration ──────────────────────────────────────────
# The hostname or IP address of the Redis server used for background queues
REDIS_HOST=localhost

# The port number the Redis server is listening on
REDIS_PORT=6379

# The name of the BullMQ queue used for dispatching email jobs
QUEUE_NAME=email-job

# ─── Seeding Configuration ────────────────────────────────────────
# The base email address used to generate test student and parent emails during DB seeding
TEST_EMAIL_ADDRESS=anything@gmail.com
