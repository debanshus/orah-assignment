# ─── Redis Configuration ──────────────────────────────────────────
# The hostname or IP address of the Redis server used by BullMQ
REDIS_HOST=localhost

# The port number the Redis server is listening on
REDIS_PORT=6379

# The name of the BullMQ queue to consume email jobs from
QUEUE_NAME=email-job

# ─── Gmail SMTP Configuration ─────────────────────────────────────
# The Gmail address used to authenticate with the SMTP server and send emails
GMAIL_USER=your_email@gmail.com

# The 16-character App Password generated from your Google Account security settings
GMAIL_APP_PASSWORD=your_app_password
